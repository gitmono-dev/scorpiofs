# ScorpioFS v3 configuration. Environment overrides use SCORPIO_<KEY>.
# CLI endpoint/store flags override environment and config values.
# The backend must serve the MST/2 snapshot API.
mst2_base_url = "http://127.0.0.1:19700"
mst2_auth_token = ""

# Workspaces live in <store_path>/workspaces-v3; content in <store_path>/mst2-cache.
store_path = "/tmp/scorpio-megadir/store"
log_level = "info"
