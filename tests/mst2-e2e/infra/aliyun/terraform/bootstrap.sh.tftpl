#!/usr/bin/env bash
# Runs only on a newly created disposable Ubuntu amd64 benchmark ECS.
# Account credentials and measured workloads are deliberately absent.
set -Eeuo pipefail
umask 022

readonly RUN_ID='${run_id}'
readonly TEST_TIER='${test_tier}'
readonly MINIMUM_CPUS='${minimum_cpus}'
readonly MINIMUM_MEMORY_GIB='${minimum_memory_gib}'
readonly MINIMUM_FREE_BYTES='${minimum_free_bytes}'
readonly STARTED_UTC='${session_started_utc}'
readonly DEADLINE_UTC='${session_deadline_utc}'
readonly EXPIRES_AT='${expires_at}'
readonly DEVICE='${data_disk_device}'
readonly DISK_GIB='${data_disk_size_gib}'
readonly DATA_ROOT=/srv/scorpiofs-benchmark
readonly CONTROL_ROOT=/var/lib/scorpiofs-benchmark
readonly DISK_RECEIPT=$CONTROL_ROOT/disk-owner
readonly READY=$CONTROL_ROOT/bootstrap-ready.json

fail() { printf 'benchmark bootstrap refused: %s\n' "$1" >&2; exit 1; }
test "$(id -u)" = 0 || fail root_required
test "$(uname -m)" = x86_64 || fail wrong_architecture
test "$(date -u +%s)" -lt "$(date -u -d "$EXPIRES_AT" +%s)" || fail original_window_expired

# Only this new disposable ECS is isolated for its original four-hour lease.
# Mask services without stopping them: an existing dpkg must finish by itself.
readonly MAINTENANCE_UNITS=(apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service)
readonly APT_PERIODIC_KEYS=(Enable Update-Package-Lists Download-Upgradeable-Packages Unattended-Upgrade AutocleanInterval)
check_maintenance_units() {
  local unit state
  for unit in "$${MAINTENANCE_UNITS[@]}"; do
    test "$(systemctl show --property=UnitFileState --value "$unit")" = masked || fail maintenance_unit_not_masked
    state=$(systemctl show --property=ActiveState --value "$unit")
    case "$state" in inactive|failed) ;; *) fail maintenance_unit_not_quiescent ;; esac
  done
}
check_maintenance_isolation() {
  local key
  check_maintenance_units
  for key in "$${APT_PERIODIC_KEYS[@]}"; do
    test "$(apt-config shell value "APT::Periodic::$key")" = "value='0'" || fail apt_periodic_policy_not_disabled
  done
  test -f /etc/needrestart/conf.d/99-scorpiofs-benchmark-list-only.conf || fail needrestart_policy_missing
  # Read the same ordered configuration layers as needrestart, including later
  # overrides. A policy file's presence alone does not establish effective mode.
  perl -e '
    our %nrconf;
    for my $path ("/etc/needrestart/needrestart.conf", sort glob "/etc/needrestart/conf.d/*.conf") {
      next unless -f $path;
      defined(do $path) or die "cannot read needrestart policy: $path";
    }
    exit(($nrconf{restart} // "") eq "l" ? 0 : 1);
  ' || fail needrestart_policy_not_list_only
}
if test "$#" -gt 0; then
  test "$#" = 1 && test "$1" = --check-maintenance-isolation || fail unsupported_bootstrap_argument
  check_maintenance_isolation
  exit 0
fi
systemctl stop apt-daily.timer apt-daily-upgrade.timer
systemctl mask "$${MAINTENANCE_UNITS[@]}"
check_maintenance_units
install -d -m 0755 /etc/apt/apt.conf.d /etc/needrestart/conf.d
cat > /etc/apt/apt.conf.d/99-scorpiofs-benchmark-no-periodic <<'APT_POLICY'
APT::Periodic::Enable "0";
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::AutocleanInterval "0";
APT_POLICY
cat > /etc/needrestart/conf.d/99-scorpiofs-benchmark-list-only.conf <<'NEEDRESTART_POLICY'
$nrconf{restart} = 'l';
NEEDRESTART_POLICY
export NEEDRESTART_MODE=l
check_maintenance_isolation

for program in lsblk blkid wipefs blockdev findmnt mountpoint mkfs.ext4; do
  command -v "$program" >/dev/null || fail missing_disk_tool
done
install -d -m 0755 -o root -g root "$CONTROL_ROOT"
test ! -L "$CONTROL_ROOT" && test ! -L "$DISK_RECEIPT" && test ! -L "$READY" || fail unsafe_control_path

# The inline ECS data disk is created with the instance. Still wait for udev;
# never guess a different disk or silently place the campaign on the system disk.
for attempt in $(seq 1 60); do
  test -b "$DEVICE" && break
  sleep 5
done
test -b "$DEVICE" && test ! -L "$DEVICE" || fail expected_new_data_disk_missing
test "$(lsblk -dnro TYPE "$DEVICE")" = disk || fail expected_whole_new_disk
test "$(blockdev --getsize64 "$DEVICE")" -ge "$((DISK_GIB * 1024 * 1024 * 1024))" || fail undersized_data_disk
ROOT_DEVICE=$(findmnt -e -n -o SOURCE /)
ROOT_ANCESTORS=$(lsblk -snrpo NAME "$ROOT_DEVICE")
test -n "$ROOT_ANCESTORS" || fail system_disk_identity_unavailable
if printf '%s\n' "$ROOT_ANCESTORS" | grep -qxF "$DEVICE"; then
  fail system_disk_selected
fi

if test -f "$DISK_RECEIPT"; then
  mapfile -t OWNER < "$DISK_RECEIPT"
  test "$${#OWNER[@]}" = 3 || fail invalid_disk_owner_receipt
  test "$${OWNER[0]}" = "$RUN_ID" && test "$${OWNER[1]}" = "$DEVICE" || fail disk_owner_mismatch
  UUID=$(blkid -s UUID -o value "$DEVICE")
  test "$UUID" = "$${OWNER[2]}" && test "$(blkid -s TYPE -o value "$DEVICE")" = ext4 || fail disk_identity_changed
else
  # Any partition, signature, or mount makes the disk ineligible for formatting.
  test "$(lsblk -nrpo TYPE "$DEVICE")" = disk || fail existing_partitions
  MOUNTPOINTS=$(lsblk -nrpo MOUNTPOINTS "$DEVICE")
  SIGNATURES=$(wipefs --no-act --noheadings "$DEVICE")
  test -z "$(printf '%s' "$MOUNTPOINTS" | tr -d '[:space:]')" || fail disk_already_mounted
  test -z "$SIGNATURES" || fail existing_disk_signature
  mkfs.ext4 -F -m 0 -L scorpio-bench "$DEVICE"
  UUID=$(blkid -s UUID -o value "$DEVICE")
  [[ "$UUID" =~ ^[a-f0-9-]{36}$ ]] || fail invalid_new_filesystem_uuid
  printf '%s\n%s\n%s\n' "$RUN_ID" "$DEVICE" "$UUID" > "$DISK_RECEIPT.new"
  chmod 0600 "$DISK_RECEIPT.new"
  mv -T "$DISK_RECEIPT.new" "$DISK_RECEIPT"
fi

test ! -L "$DATA_ROOT" || fail unsafe_data_mount_path
install -d -m 0755 -o root -g root "$DATA_ROOT"
FSTAB_LINE="UUID=$UUID $DATA_ROOT ext4 defaults 0 2"
if awk -v point="$DATA_ROOT" '$2 == point {found=1} END {exit !found}' /etc/fstab; then
  grep -qxF "$FSTAB_LINE" /etc/fstab || fail existing_mount_configuration
else
  printf '%s\n' "$FSTAB_LINE" >> /etc/fstab
fi
mountpoint -q "$DATA_ROOT" || mount "$DATA_ROOT"
test "$(findmnt -n -o UUID --target "$DATA_ROOT")" = "$UUID" || fail mounted_wrong_filesystem
test "$(findmnt -n -o TARGET --target "$DATA_ROOT")" = "$DATA_ROOT" || fail data_mount_missing
test "$(df -B1 --output=avail "$DATA_ROOT" | tail -1 | tr -d ' ')" -ge "$MINIMUM_FREE_BYTES" || fail insufficient_campaign_disk

export DEBIAN_FRONTEND=noninteractive
# This file belongs to earlier attempts of this disposable host's bootstrap.
# Use Ubuntu's signed distribution packages for the Docker engine and Compose.
rm -f /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y ca-certificates curl gnupg sudo git jq python3 python3-venv pkg-config libssl-dev libfuse3-dev fuse3 protobuf-compiler postgresql-client build-essential docker.io docker-compose-v2 time
. /etc/os-release
test "$ID" = ubuntu || fail unsupported_distribution
case "$VERSION_ID" in 24.04) ;; *) fail unsupported_ubuntu_version ;; esac

if ! id benchmark >/dev/null 2>&1; then
  useradd --create-home --home-dir "$DATA_ROOT/test-home" --shell /bin/bash benchmark
fi
test "$(getent passwd benchmark | cut -d: -f6)" = "$DATA_ROOT/test-home" || fail test_home_mismatch
usermod -aG docker benchmark
for directory in cargo rustup test-home work tmp evidence; do
  install -d -m 0750 -o benchmark -g benchmark "$DATA_ROOT/$directory"
done
# The official OSS SDK signs transfers using ephemeral ECS role credentials.
# Keep this environment root-owned: Cloud Assistant controls the transfer service.
install -d -m 0755 -o root -g root "$DATA_ROOT/sdk"
python3 -m venv "$DATA_ROOT/sdk"
"$DATA_ROOT/sdk/bin/python" -m pip --isolated install --disable-pip-version-check --no-cache-dir --index-url https://mirrors.aliyun.com/pypi/simple 'oss2==2.19.1'
"$DATA_ROOT/sdk/bin/python" -c 'import oss2; assert oss2.__version__ == "2.19.1"'
install -d -m 0711 -o root -g root "$DATA_ROOT/docker"
install -d -m 0755 -o root -g root /etc/docker
printf '{"data-root":"%s/docker","registry-mirrors":["https://w23geq7ncegg6etqsl.xuanyuan.run"]}\n' "$DATA_ROOT" > /etc/docker/daemon.json
systemctl enable --now docker
systemctl restart docker
test "$(docker info --format '{{.DockerRootDir}}')" = "$DATA_ROOT/docker" || fail docker_storage_not_on_data_disk
docker info --format '{{json .RegistryConfig.Mirrors}}' | python3 -c 'import json, sys; assert [value.rstrip("/") for value in json.load(sys.stdin)] == ["https://w23geq7ncegg6etqsl.xuanyuan.run"]'
docker compose version

printf 'benchmark ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/scorpiofs-benchmark
chmod 0440 /etc/sudoers.d/scorpiofs-benchmark
visudo -cf /etc/sudoers.d/scorpiofs-benchmark
grep -qxF user_allow_other /etc/fuse.conf || printf '\nuser_allow_other\n' >> /etc/fuse.conf
test -c /dev/fuse || modprobe fuse
test -c /dev/fuse || fail fuse_device_missing
chmod 0666 /dev/fuse
runuser -u benchmark -- test -r /dev/fuse
runuser -u benchmark -- test -w /dev/fuse
fusermount3 --version

export CARGO_HOME=$DATA_ROOT/cargo
export RUSTUP_HOME=$DATA_ROOT/rustup
export TMPDIR=$DATA_ROOT/tmp
export PATH=$CARGO_HOME/bin:$PATH
# Registry downloads need their own mirror; Rustup's mirror does not configure
# Cargo. Keep locked dependency identities and avoid observed HTTP/2 resets.
test ! -L "$CARGO_HOME/config.toml" || fail unsafe_cargo_configuration
cat > "$CARGO_HOME/config.toml" <<'CARGO_CONFIG'
[source.crates-io]
replace-with = "rsproxy-sparse"

[source.rsproxy-sparse]
registry = "sparse+https://rsproxy.cn/index/"

[http]
multiplexing = false
CARGO_CONFIG
chown benchmark:benchmark "$CARGO_HOME/config.toml"
chmod 0640 "$CARGO_HOME/config.toml"
export RUSTUP_DIST_SERVER=https://rsproxy.cn
export RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup
runuser -u benchmark -- env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" TMPDIR="$TMPDIR" \
  RUSTUP_DIST_SERVER="$RUSTUP_DIST_SERVER" RUSTUP_UPDATE_ROOT="$RUSTUP_UPDATE_ROOT" bash -euo pipefail -c '
    installer_dir=$(mktemp -d "$TMPDIR/rustup-bootstrap.XXXXXX")
    trap '\''rm -rf -- "$installer_dir"'\'' EXIT
    curl --retry 2 --max-time 120 --proto "=https" --tlsv1.2 -fsSL \
      "$RUSTUP_UPDATE_ROOT/dist/x86_64-unknown-linux-gnu/rustup-init" -o "$installer_dir/rustup-init"
    chmod 0700 "$installer_dir/rustup-init"
    "$installer_dir/rustup-init" -y --profile minimal --default-toolchain 1.98.1 \
      --component rustfmt --component clippy --no-modify-path
  '
for program in cargo rustc rustup; do
  ln -sfn "$CARGO_HOME/bin/$program" "/usr/local/bin/$program"
done
printf 'export CARGO_HOME=%s/cargo\nexport RUSTUP_HOME=%s/rustup\nexport TMPDIR=%s/tmp\nexport PATH=%s/cargo/bin:$PATH\n' "$DATA_ROOT" "$DATA_ROOT" "$DATA_ROOT" "$DATA_ROOT" > /etc/profile.d/scorpiofs-benchmark.sh
runuser -u benchmark -- env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" rustc --version
runuser -u benchmark -- env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" rustc --version | grep -q '^rustc 1\.98\.1 ' || fail rust_toolchain_version_mismatch
for component in rustfmt clippy; do
  runuser -u benchmark -- env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" \
    rustup component list --toolchain 1.98.1 --installed | grep -qx "$component-x86_64-unknown-linux-gnu" || fail rust_toolchain_component_missing
done

# The direct controller checks this receipt, the original window, and the mount.
# The public instance type is separately checked by the external controller.
check_maintenance_isolation
TEST_UID=$(id -u benchmark)
TEST_GID=$(id -g benchmark)
export RUN_ID TEST_TIER MINIMUM_CPUS MINIMUM_MEMORY_GIB MINIMUM_FREE_BYTES STARTED_UTC DEADLINE_UTC EXPIRES_AT DATA_ROOT DEVICE UUID TEST_UID TEST_GID READY
python3 - <<'PY'
import datetime
import json
import os
from pathlib import Path
import shutil

env = os.environ
memory = int(next(line.split()[1] for line in Path('/proc/meminfo').read_text().splitlines()
                  if line.startswith('MemTotal:'))) * 1024
cpus = os.cpu_count()
free = shutil.disk_usage(env['DATA_ROOT']).free
if cpus < int(env['MINIMUM_CPUS']) or memory < int(env['MINIMUM_MEMORY_GIB']) * 1024 ** 3 or free < int(env['MINIMUM_FREE_BYTES']):
    raise SystemExit('benchmark runtime shape or remaining disk is insufficient')
if datetime.datetime.now(datetime.timezone.utc) >= datetime.datetime.fromisoformat(env['EXPIRES_AT'].replace('Z', '+00:00')):
    raise SystemExit('original hard release deadline is exhausted')
receipt = dict(revision=2, status='ready', campaign_id=env['RUN_ID'],
               test_tier=env['TEST_TIER'], execution_mode='cloud-assistant',
               session_started_utc=env['STARTED_UTC'], session_deadline_utc=env['DEADLINE_UTC'],
               hard_release_utc=env['EXPIRES_AT'], data_root=env['DATA_ROOT'],
               test_arch='linux-x64', test_user='benchmark',
               test_uid=int(env['TEST_UID']), test_gid=int(env['TEST_GID']),
               disk_device=env['DEVICE'], disk_uuid=env['UUID'], disk_free_bytes=free,
               logical_cpus=cpus, memory_bytes=memory)
target = Path(env['READY'])
temporary = target.with_suffix('.new')
with temporary.open('x', encoding='utf-8') as stream:
    json.dump(receipt, stream, sort_keys=True)
    stream.write('\n')
    stream.flush()
    os.fsync(stream.fileno())
temporary.chmod(0o644)
temporary.replace(target)
PY
printf 'benchmark bootstrap ready: %s\n' "$RUN_ID"
