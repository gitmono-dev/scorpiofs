# Copy only to the external per-run state directory. These values are examples.
# Authentication is supplied through the standard provider environment.
region        = "cn-hangzhou"
zone          = "cn-hangzhou-h"
image_id      = "<reviewed-ubuntu-amd64-image-id>"
instance_type = "<available-8vcpu-32gib-ecs-type>"
run_id        = "<globally-unique-run-id>"
test_tier     = "history-large"

# The controller replaces these together once, before the first create.
session_started_utc = "2026-10-08T00:00:00Z"
expires_at          = "2026-10-08T04:00:00Z"
vpc_cidr            = "10.71.0.0/16"
vswitch_cidr        = "10.71.1.0/24"

data_disk_size_gib         = 300
data_disk_device           = "/dev/vdb"
internet_max_bandwidth_out = 20
evidence_retention_days    = 7
